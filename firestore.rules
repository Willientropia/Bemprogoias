rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid} guarda só o essencial pra sessão saber quem é o usuário:
    // role + campaignId. Sempre um get() de doc único — nunca list — então
    // não há risco de vazamento entre campanhas aqui.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myProfile().role
        : null;
    }

    function myCampaignId() {
      return myProfile().campaignId;
    }

    function isSuperAdmin() {
      return isSignedIn() && myRole() == 'super_admin';
    }

    function isManagerOf(cId) {
      return isSignedIn() && myRole() == 'manager' && myCampaignId() == cId;
    }

    function isLeaderOf(cId) {
      return isSignedIn() && myRole() == 'leader' && myCampaignId() == cId;
    }

    // users/{uid}: espelho mínimo (role, campaignId) usado só para a própria
    // sessão descobrir quem é. Cada usuário lê apenas o próprio. Super_admin
    // escreve qualquer um; gestor só pode espelhar líderes da própria
    // campanha (perfil completo "de verdade" fica em
    // campaigns/{campaignId}/members/{uid}, ver abaixo).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin()
        || (isSignedIn() && request.resource.data.role == 'leader'
            && isManagerOf(request.resource.data.campaignId));

      allow update: if isSuperAdmin()
        || (isSignedIn()
            && resource.data.role == 'leader'
            && request.resource.data.role == 'leader'
            && isManagerOf(resource.data.campaignId)
            && request.resource.data.campaignId == resource.data.campaignId);

      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.role == 'leader' && isManagerOf(resource.data.campaignId));
    }

    match /campaigns/{campaignId} {
      allow read: if isSuperAdmin() || isManagerOf(campaignId) || isLeaderOf(campaignId);
      allow write: if isSuperAdmin();

      // O gestor configura para onde e a que hora sai o relatório da campanha
      // dele. `hasOnly` limita a exatamente estes três campos: sem isso, um
      // update legítimo de relatório seria brecha para reescrever qualquer
      // outra coisa do documento da campanha.
      allow update: if isManagerOf(campaignId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reportRecipientWhatsapp',
          'reportDeliveryTime',
          'reportSettingsUpdatedAt'
        ])
        && request.resource.data.reportRecipientWhatsapp is string
        && request.resource.data.reportRecipientWhatsapp.size() >= 8
        && request.resource.data.reportRecipientWhatsapp.size() <= 25
        && request.resource.data.reportDeliveryTime is string
        && request.resource.data.reportDeliveryTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');

      // Gestores e líderes da campanha. Isolamento por campanha vem do
      // próprio path (subcoleção), então list/query aqui é seguro por
      // construção — diferente de uma coleção users plana na raiz.
      match /members/{uid} {
        allow read: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId) && uid == request.auth.uid);
        allow list: if isSuperAdmin() || isManagerOf(campaignId);
        allow create: if isSuperAdmin()
          || (isManagerOf(campaignId)
            && request.resource.data.role == 'leader'
            && request.resource.data.campaignId == campaignId);
        allow update: if isSuperAdmin()
          || (isManagerOf(campaignId)
            && resource.data.role == 'leader'
            && request.resource.data.role == 'leader'
            && request.resource.data.campaignId == campaignId);
        allow delete: if isSuperAdmin()
          || (isManagerOf(campaignId) && resource.data.role == 'leader');
      }

      match /voters/{voterId} {
        allow read: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId) && resource.data.leaderId == request.auth.uid);

        allow create: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId)
            && request.resource.data.leaderId == request.auth.uid
            && request.resource.data.campaignId == campaignId);

        allow update: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId)
            && resource.data.leaderId == request.auth.uid
            && request.resource.data.leaderId == request.auth.uid
            && request.resource.data.campaignId == campaignId);

        allow delete: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId) && resource.data.leaderId == request.auth.uid);
      }

      // Reserva atômica de RG/título para impedir duplicidade na campanha.
      match /voterKeys/{keyId} {
        allow get: if isSuperAdmin() || isManagerOf(campaignId) || isLeaderOf(campaignId);
        allow list: if isSuperAdmin() || isManagerOf(campaignId);
        allow create: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId)
            && request.resource.data.leaderId == request.auth.uid
            && request.resource.data.campaignId == campaignId);
        allow update: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId)
            && resource.data.leaderId == request.auth.uid
            && request.resource.data.leaderId == request.auth.uid
            && request.resource.data.campaignId == campaignId);
        allow delete: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId) && resource.data.leaderId == request.auth.uid);
      }

      // Posição voluntariamente compartilhada pelo líder durante o trabalho.
      match /leaderLocations/{leaderId} {
        allow get: if isSuperAdmin() || isManagerOf(campaignId)
          || (isLeaderOf(campaignId) && leaderId == request.auth.uid);
        allow list: if isSuperAdmin() || isManagerOf(campaignId);
        allow create, update: if isLeaderOf(campaignId)
          && leaderId == request.auth.uid
          && request.resource.data.leaderId == request.auth.uid
          && request.resource.data.campaignId == campaignId;
        allow delete: if isLeaderOf(campaignId) && leaderId == request.auth.uid;
      }
    }
  }
}
